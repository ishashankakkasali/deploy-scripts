{
  "id": "emr-service-protocol",
  "url": "http://openphc.org/PlanDefinition/emr-service-protocol",
  "date": "2026-06-22",
  "name": "EmrServiceProtocol",
  "title": "Facility service journey",
  "action": [
    {
      "id": "visit-encounter",
      "type": {
        "coding": [
          {
            "code": "step",
            "system": "http://openphc.org/fhir/CodeSystem/action-type"
          }
        ]
      },
      "title": "Patient Visit",
      "trigger": [
        {
          "data": [
            {
              "type": "Encounter",
              "codeFilter": [
                {
                  "code": [
                    {
                      "display": "VISIT_ENCOUNTER"
                    }
                  ],
                  "path": "type"
                }
              ]
            }
          ],
          "name": "visit-encounter-trigger",
          "type": "named-event"
        }
      ],
      "description": "Enrollment trigger - nursing-station check-in. Matches Encounter with type display VISIT_ENCOUNTER. Uses display-only coding since Ebuzima payloads do not include a code field in type[].",
      "timingTiming": {
        "repeat": {
          "count": 1,
          "period": 1,
          "frequency": 1,
          "periodUnit": "d"
        }
      },
      "requiredBehavior": "could"
    },
    {
      "id": "vitals-recording",
      "type": {
        "coding": [
          {
            "code": "step",
            "system": "http://openphc.org/fhir/CodeSystem/action-type"
          }
        ]
      },
      "title": "Vitals Recording",
      "trigger": [
        {
          "data": [
            {
              "type": "Observation",
              "codeFilter": [
                {
                  "code": [
                    {
                      "code": "8716-3",
                      "system": "http://loinc.org",
                      "display": "Vital signs"
                    }
                  ],
                  "path": "code"
                }
              ]
            }
          ],
          "name": "vitals-trigger",
          "type": "named-event"
        }
      ],
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "description": "Nursing station vitals observation. Matches Observation with LOINC code 8716-3 (Vital signs). Payload includes BP, HR, RR, SpO2, temp, weight, height, BMI, blood glucose as components.",
      "timingTiming": {
        "repeat": {
          "count": 1,
          "period": 1,
          "frequency": 1,
          "periodUnit": "d"
        }
      },
      "requiredBehavior": "must",
      "relatedAction": [
        {
          "actionId": "visit-encounter",
          "relationship": "after-start",
          "offsetDuration": {
            "code": "d",
            "unit": "d",
            "value": 1,
            "system": "http://unitsofmeasure.org"
          }
        }
      ]
    },
    {
      "id": "consultation",
      "type": {
        "coding": [
          {
            "code": "step",
            "system": "http://openphc.org/fhir/CodeSystem/action-type"
          }
        ]
      },
      "title": "Clinical Consultation",
      "action": [
        {
          "id": "chief-complaints",
          "type": {
            "coding": [
              {
                "code": "step",
                "system": "http://openphc.org/fhir/CodeSystem/action-type"
              }
            ]
          },
          "title": "Chief Complaints",
          "trigger": [
            {
              "data": [
                {
                  "type": "Observation",
                  "codeFilter": [
                    {
                      "code": [
                        {
                          "code": "33747-0",
                          "system": "http://loinc.org",
                          "display": "Chief Complaints"
                        }
                      ],
                      "path": "code"
                    }
                  ]
                }
              ],
              "name": "chief-complaints-trigger",
              "type": "named-event"
            }
          ],
          "description": "Clinical consultation - chief complaints recording. Matches Observation with LOINC code 33747-0 (Chief Complaints).",
          "timingTiming": {
            "repeat": {
              "count": 1,
              "period": 1,
              "frequency": 1,
              "periodUnit": "d"
            }
          },
          "requiredBehavior": "could",
          "relatedAction": [
            {
              "actionId": "consultation",
              "relationship": "after-end",
              "offsetDuration": {
                "code": "d",
                "unit": "d",
                "value": 1,
                "system": "http://unitsofmeasure.org"
              }
            }
          ]
        },
        {
          "id": "history-assessment",
          "type": {
            "coding": [
              {
                "code": "step",
                "system": "http://openphc.org/fhir/CodeSystem/action-type"
              }
            ]
          },
          "title": "History of Present Illness",
          "trigger": [
            {
              "data": [
                {
                  "type": "Observation",
                  "codeFilter": [
                    {
                      "code": [
                        {
                          "code": "10164-2",
                          "system": "http://loinc.org",
                          "display": "History of Present illness Narrative"
                        }
                      ],
                      "path": "code"
                    }
                  ]
                }
              ],
              "name": "history-trigger",
              "type": "named-event"
            }
          ],
          "description": "Clinical consultation - history recording. Matches Observation with LOINC code 10164-2 (History of Present illness Narrative).",
          "timingTiming": {
            "repeat": {
              "count": 1,
              "period": 1,
              "frequency": 1,
              "periodUnit": "d"
            }
          },
          "requiredBehavior": "could",
          "relatedAction": [
            {
              "actionId": "chief-complaints",
              "relationship": "after-end",
              "offsetDuration": {
                "code": "d",
                "unit": "d",
                "value": 1,
                "system": "http://unitsofmeasure.org"
              }
            }
          ]
        },
        {
          "id": "lab-order",
          "type": {
            "coding": [
              {
                "code": "step",
                "system": "http://openphc.org/fhir/CodeSystem/action-type"
              }
            ]
          },
          "title": "Laboratory Order",
          "action": [
            {
              "id": "lab-results",
              "type": {
                "coding": [
                  {
                    "code": "step",
                    "system": "http://openphc.org/fhir/CodeSystem/action-type"
                  }
                ]
              },
              "title": "Laboratory Results",
              "trigger": [
                {
                  "data": [
                    {
                      "type": "Observation",
                      "codeFilter": [
                        {
                          "code": [
                            {
                              "code": "laboratory",
                              "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                              "display": "Laboratory"
                            }
                          ],
                          "path": "category"
                        }
                      ]
                    }
                  ],
                  "name": "lab-results-trigger",
                  "type": "named-event"
                }
              ],
              "description": "Lab results returned. Matches Observation with category laboratory. Uses category-path codeFilter to distinguish from vital-signs and survey observations. Sub-step of lab-order.",
              "timingTiming": {
                "repeat": {
                  "count": 1,
                  "period": 1,
                  "frequency": 1,
                  "periodUnit": "d"
                }
              },
              "requiredBehavior": "could",
              "relatedAction": [
                {
                  "actionId": "lab-order",
                  "relationship": "after-end",
                  "offsetDuration": {
                    "code": "d",
                    "unit": "d",
                    "value": 3,
                    "system": "http://unitsofmeasure.org"
                  }
                }
              ]
            }
          ],
          "trigger": [
            {
              "data": [
                {
                  "type": "ServiceRequest"
                }
              ],
              "name": "lab-order-trigger",
              "type": "named-event"
            }
          ],
          "description": "Lab test ordered by clinician. Matches any ServiceRequest (F1 scenario). Ebuzima ServiceRequest payloads have non-standard category structure (object instead of array), so only resource-type matching is used.",
          "timingTiming": {
            "repeat": {
              "count": 1,
              "period": 1,
              "frequency": 1,
              "periodUnit": "d"
            }
          },
          "requiredBehavior": "could",
          "relatedAction": [
            {
              "actionId": "history-assessment",
              "relationship": "after-end",
              "offsetDuration": {
                "code": "d",
                "unit": "d",
                "value": 1,
                "system": "http://unitsofmeasure.org"
              }
            }
          ]
        },
        {
          "id": "diagnosis",
          "type": {
            "coding": [
              {
                "code": "step",
                "system": "http://openphc.org/fhir/CodeSystem/action-type"
              }
            ]
          },
          "title": "Clinical Diagnosis",
          "trigger": [
            {
              "data": [
                {
                  "type": "Condition",
                  "codeFilter": [
                    {
                      "code": [
                        {
                          "code": "active",
                          "system": "http://terminology.hl7.org/CodeSystem/condition-clinical"
                        }
                      ],
                      "path": "clinicalStatus"
                    }
                  ]
                }
              ],
              "name": "diagnosis-trigger",
              "type": "named-event"
            }
          ],
          "extension": [
            {
              "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
              "valueInteger": 1
            }
          ],
          "description": "Diagnosis recorded. Matches Condition with clinicalStatus active. The Ebuzima payload carries ICD code 5A11 (Type 2 diabetes mellitus) in the code field.",
          "timingTiming": {
            "repeat": {
              "count": 1,
              "period": 1,
              "frequency": 1,
              "periodUnit": "d"
            }
          },
          "requiredBehavior": "must",
          "relatedAction": [
            {
              "actionId": "lab-results",
              "relationship": "after-end",
              "offsetDuration": {
                "code": "d",
                "unit": "d",
                "value": 2,
                "system": "http://unitsofmeasure.org"
              }
            }
          ]
        },
        {
          "id": "treatment",
          "type": {
            "coding": [
              {
                "code": "step",
                "system": "http://openphc.org/fhir/CodeSystem/action-type"
              }
            ]
          },
          "title": "Treatment Prescription",
          "trigger": [
            {
              "data": [
                {
                  "type": "MedicationRequest"
                }
              ],
              "name": "treatment-trigger",
              "type": "named-event"
            }
          ],
          "description": "Medication prescribed. Matches any MedicationRequest (F1 scenario). Ebuzima payloads use medicationCodeableConcept which is not in the standard extraction paths, so only resource-type matching is used. Expected medications: CAPTOPRIL 25MG (C09AA0101E), METFORMIN 500MG (A10BA0201E).",
          "timingTiming": {
            "repeat": {
              "count": 1,
              "period": 1,
              "frequency": 1,
              "periodUnit": "d"
            }
          },
          "requiredBehavior": "could",
          "relatedAction": [
            {
              "actionId": "diagnosis",
              "relationship": "after-end",
              "offsetDuration": {
                "code": "d",
                "unit": "d",
                "value": 1,
                "system": "http://unitsofmeasure.org"
              }
            }
          ]
        },
        {
          "id": "referral",
          "type": {
            "coding": [
              {
                "code": "step",
                "system": "http://openphc.org/fhir/CodeSystem/action-type"
              }
            ]
          },
          "title": "Referral",
          "trigger": [
            {
              "data": [
                {
                  "type": "Encounter",
                  "codeFilter": [
                    {
                      "code": [
                        {
                          "display": "TRANSFER_ENCOUNTER"
                        }
                      ],
                      "path": "type"
                    }
                  ]
                }
              ],
              "name": "referral-trigger",
              "type": "named-event"
            }
          ],
          "description": "Patient referral/transfer to another facility. Matches Encounter with type display TRANSFER_ENCOUNTER.",
          "timingTiming": {
            "repeat": {
              "count": 1,
              "period": 1,
              "frequency": 1,
              "periodUnit": "d"
            }
          },
          "requiredBehavior": "could",
          "relatedAction": [
            {
              "actionId": "treatment",
              "relationship": "after-end",
              "offsetDuration": {
                "code": "d",
                "unit": "d",
                "value": 1,
                "system": "http://unitsofmeasure.org"
              }
            }
          ]
        }
      ],
      "trigger": [
        {
          "data": [
            {
              "type": "Encounter",
              "codeFilter": [
                {
                  "code": [
                    {
                      "display": "CONSULTATION_ENCOUNTER"
                    }
                  ],
                  "path": "type"
                }
              ]
            }
          ],
          "name": "consultation-trigger",
          "type": "named-event"
        }
      ],
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "description": "Clinical consultation encounter. Matches Encounter with type display CONSULTATION_ENCOUNTER. Parent of the consultation sub-steps (complaints, history, lab order/results, diagnosis, treatment, referral).",
      "timingTiming": {
        "repeat": {
          "count": 1,
          "period": 1,
          "frequency": 1,
          "periodUnit": "d"
        }
      },
      "requiredBehavior": "must",
      "relatedAction": [
        {
          "actionId": "vitals-recording",
          "relationship": "after-end",
          "offsetDuration": {
            "code": "d",
            "unit": "d",
            "value": 1,
            "system": "http://unitsofmeasure.org"
          }
        }
      ]
    }
  ],
  "status": "active",
  "version": "1.0.0",
  "description": "Tracks an outpatient visit workflow from the Ebuzima HIE: nursing-station check-in (VISIT_ENCOUNTER), vitals recording, then a clinical consultation (CONSULTATION_ENCOUNTER) whose sub-steps cover chief complaints, history, laboratory ordering and results, diagnosis, treatment prescription, and referral. Designed to match CloudEvents from the OpenHIM mediator carrying FHIR R4 resources.",
  "resourceType": "PlanDefinition"
}