# Example settings for migrate-1x-to-2x.sh: a laptop running CCE 1.x with Docker Compose, e.g. on a
# restored copy of a 1.x database. Copy it, adjust it to your setup, then run:
#   M="bash upgrade-1x-to-2x/data-migration/migrate-1x-to-2x.sh --config <your copy>"
#   $M check
NAME=local-migration                   # state, backup and report go to ~/cce-migration/<NAME>/

# Docker Compose: the folder with your compose files, and the files, in order (':'-separated):
#   1. your CCE 1.x file;
#   2. a file defining the 2.0 services (cce-protocol-service, cce-matcher-service, cce-step-sla-service,
#      and the 2.0 Insights), with the same container names;
#   3. docker-compose.baseline-1.yml from this folder (Flyway baseline 1 on Protocol and Matcher).
COMPOSE_DIR=$HOME/<your-cce-compose-folder>
COMPOSE_FILES=docker-compose.yml:docker-compose.2x.yml:$SCRIPT_DIR/docker-compose.baseline-1.yml

# Postgres, Kafka and Kafka Connect: the containers their tools run in
PG_EXEC="docker exec -i cce-collector-postgres"
KAFKA_EXEC="docker exec -i cce-collector-kafka"
KAFKA_TOOLS_DIR=/opt/kafka/bin         # Apache Kafka image; remove both lines for a Confluent image
KAFKA_TOOL_SUFFIX=.sh
KAFKA_BOOTSTRAP=localhost:9092         # the broker, as seen from inside the Kafka container
CONNECT_EXEC="docker exec -i cce-kafka-connect"
CONNECT_URL=http://localhost:8083      # Kafka Connect, as seen from inside its container
CH_HTTP=http://localhost:8123          # ClickHouse over HTTP, from this laptop

# ClickHouse user and password: a file (mode 600) with two lines, CH_USER=... and CH_PASSWORD=...
SECRETS_FILE=$HOME/.cce-replay-secrets.env

# The 2.0 data-pipeline (ClickHouse is rebuilt with it), and the migration folder of a
# cce-matcher-service checkout (its verify.sql checks the migrated schema)
DATA_PIPELINE_DIR=$SCRIPT_DIR/../../data-pipeline
MATCHER_MIGRATION_DIR=$HOME/<path>/cce-matcher-service/migration

# Service and group names (defaults shown)
# OLD_SERVICES="cce-compliance-service cce-scheduler-service"
# PROTOCOL=cce-protocol-service  MATCHER=cce-matcher-service  STEP_SLA=cce-step-sla-service
# INSIGHTS_SERVICES="cce-insights-service cce-insights-ui"
# OLD_GROUP=cce-compliance-service  NEW_GROUP=cce-matcher-service

# Optional: replace stored protocol definitions (same url and version) while 1.x is stopped
# ('update-protocol'), and rebuild their trigger index once Protocol runs ('rebuild-index'). Here:
# Rwanda UAT's emr-service-protocol 1.0.0 converted to the 2.0 relatedAction direction
# (../replay/protocol-conversion/README.md). Leave PROTOCOL_UPDATES empty when no definition must change.
PROTOCOL_UPDATES="$SCRIPT_DIR/../replay/protocol-conversion/emr-service-protocol-1.0.0-2x.json"
PROTOCOL_API_URL=http://localhost:8094   # Protocol's API, as seen from this laptop (its published port)
