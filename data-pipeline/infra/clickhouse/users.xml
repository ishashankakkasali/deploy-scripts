<clickhouse>
    <profiles>
        <!-- Analytics profile: final=1 makes reads auto-apply FINAL (correct dedup without explicit
             FINAL). NOTE: this profile is defined but NOT auto-assigned to cce_pipeline — see below. -->
        <analytics>
            <final>1</final>
            <max_execution_time>60</max_execution_time>
            <readonly>1</readonly>
        </analytics>
    </profiles>

    <users>
        <!-- cce_pipeline is created by the ClickHouse entrypoint from CLICKHOUSE_USER / CLICKHOUSE_PASSWORD
             (docker-compose). We must NOT redefine its password / profile / networks here — if both the
             entrypoint and this mounted file set a field, startup crashes with
             "More than one field of 'password' … for user cce_pipeline".
             The ONLY thing we add is <grants>:
               - GRANT ALL ON *.*            — the entrypoint user needs explicit privileges
               - GRANT NAMED COLLECTION …    — required to use ENGINE = Kafka(cce_kafka) (schema/02)
             TRADE-OFF: because the <analytics> profile can't be assigned to this entrypoint-created
             user via a mount, `final=1` auto-FINAL is NOT active for cce_pipeline. Reads that need
             dedup must use FINAL explicitly, or assign the profile once with:
               ALTER USER cce_pipeline SETTINGS PROFILE 'analytics'; -->
        <cce_pipeline>
            <grants>
                <query>GRANT ALL ON *.*</query>
                <query>GRANT NAMED COLLECTION ON cce_kafka</query>
            </grants>
        </cce_pipeline>
    </users>
</clickhouse>
